"data/events_special_storage.xml.append$//event[@name=\"STORAGE_CHECK_LILY_LOREDUMP_8\"]/choice[2]/text"
msgstr "이제 다 끝났나요?"

#: src-en/data/events_special_storage.xml.append:785
msgid ""
"data/events_special_storage.xml.append$//event[@name=\"STORAGE_CHECK_LILY_LOREDUMP_7\"]/choice[2]/text"
msgstr "그만하세요."

#: src-en/data/events_special_storage.xml.append:791
msgid ""
"data/events_special_storage.xml.append$//event[@name=\"STORAGE_CHECK_LILY_LOREDUMP_6\"]/choice[2]/text"
msgstr "제발 그만 좀 하세요."

#: src-en/data/events_special_storage.xml.append:797
msgid ""
"data/events_special_storage.xml.append$//event[@name=\"STORAGE_CHECK_LILY_LOREDUMP_5\"]/choice[2]/text"
msgstr "그만!"

#: src-en/data/events_special_storage.xml.append:803
