#: src-en/data/events_special_storage.xml.append:973
msgid ""
"data/events_special_storage.xml.append$//event[@name=\"STORAGE_CHECK_LAB_LILY_SIREN\"]/choice[9]/text"
msgstr "1차: 시드는 시선. [이미 업그레이드가 설치되어 있습니다]"

#: src-en/data/events_special_storage.xml.append:977
msgid ""
"data/events_special_storage.xml.append$//event[@name=\"STORAGE_CHECK_LAB_LILY_SIREN\"]/choice[10]/text"
msgstr "1차: 시드는 시선. [비용: 40~, 8}]"

#: src-en/data/events_special_storage.xml.append:981
msgid ""
"data/events_special_storage.xml.append$//event[@name=\"STORAGE_CHECK_LAB_LILY_SIREN\"]/choice[@req=\"LAB_LILY_SIREN_HARPY_MIND\""
" and @lvl=\"1\"]/text"
msgstr ""
"2차 [하피]: 정신 장악. [이미 업그레이드가 설치되어 있습니다]\n"
"[세이렌 하피가 새 액티브 능력을 얻습니다: 현재 있는 방의 무작위 적 선원 "
"1명을 10초 동안 정신 지배합니다. (재사용 대기시간 30초)]"

#: src-en/data/events_special_storage.xml.append:986
msgid ""
"data/events_special_storage.xml.append$//event[@name=\"STORAGE_CHECK_LAB_LILY_SIREN\"]/choice[@req=\"LAB_LILY_SIREN_HARPY_MIND\""
