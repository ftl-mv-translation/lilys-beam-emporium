#: src-en/data/events.xml.append:347
msgid ""
"data/events.xml.append$//event[@name=\"LILY_EMPORIUM_REAL\"]/choice[@req=\"LIST_CREW_SIREN\"]/event/choice/event/choice[2]/event/text"
msgstr "\"That's a shame, but feel free to browse my store regardless--\""

