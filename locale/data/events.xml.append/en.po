#: src-en/data/events.xml.append:392
msgid ""
"data/events.xml.append$//event[@name=\"LILY_EMPORIUM_REAL\"]/choice[@req=\"lily_questioned\"]/text"
msgstr "Question her about the anomalies."

#: src-en/data/events.xml.append:395
msgid ""
"data/events.xml.append$//event[@name=\"LILY_EMPORIUM_REAL\"]/choice[@req=\"lily_questioned\"]/event/text"
msgstr ""
"You question her about the anomalies.\n"
"\"Your systems glitched out, you say?--\n"
"That's very odd, you are the first one to complain about this--\n"
"Mind if I take a look at them? For free even--\""

#: src-en/data/events.xml.append:400
msgid ""
"data/events.xml.append$//event[@name=\"LILY_EMPORIUM_REAL\"]/choice[@req=\"lily_questioned\"]/event/choice[1]/text"
msgstr "Sure."

#: src-en/data/events.xml.append:411
msgid ""
"data/events.xml.append$//event[@name=\"LILY_EMPORIUM_REAL\"]/choice[@req=\"lily_questioned\"]/event/choice[2]/text"
msgstr "No thanks."

#: src-en/data/events.xml.append:413
msgid "data/events.xml.append$//event[@name=\"LILY_EMPORIUM_STOREASK\"]/text"
msgstr "\"Alright. Do you want to shop still?--\""

#: src-en/data/events.xml.append:415
msgid ""
"data/events.xml.append$//event[@name=\"LILY_EMPORIUM_STOREASK\"]/choice[1]/text"
msgstr "Yes."

#: src-en/data/events.xml.append:421
msgid ""
"data/events.xml.append$//event[@name=\"LILY_EMPORIUM_STOREASK\"]/choice[2]/text"
