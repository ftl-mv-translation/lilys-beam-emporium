#: src-en/data/events.xml.append:710
msgid ""
"data/events.xml.append$//event[@name=\"TRANSPORT_CAPTURE_STARGROVE_LILY\"]/text"
msgstr ""
"\"Such a beautiful vessel, of Siren design no less--\n"
"And in such disrepair...\n"
