#: src-en/data/events.xml.append:423
msgid ""
"data/events.xml.append$//event[@name=\"LILY_EMPORIUM_STOREASK\"]/choice[2]/event/text"
msgstr "You decide not to shop and just continue on your journey."

#: src-en/data/events.xml.append:431
msgid ""
"data/events.xml.append$//event[@name=\"LILY_EMPORIUM_REAL\"]/choice[6]/text"
msgstr "Attack the station, we can get some goods by force!"

#: src-en/data/events.xml.append:433
msgid ""
"data/events.xml.append$//event[@name=\"LILY_EMPORIUM_REAL\"]/choice[6]/event/text"
msgstr ""
"\"Wait wait wait wait wait!--\n"
"Are you really just going to attack a civilian station?\n"
"You will get notoriety for this, don't you know? 2x even!--\n"
"Besides, I'm actually an optional boss and you definitely aren't ready to fight me yet!--\""

#: src-en/data/events.xml.append:438
msgid ""
"data/events.xml.append$//event[@name=\"LILY_EMPORIUM_REAL\"]/choice[6]/event/choice[1]/text"
msgstr "Change your mind and go back."

#: src-en/data/events.xml.append:444
msgid ""
"data/events.xml.append$//event[@name=\"LILY_EMPORIUM_REAL\"]/choice[6]/event/choice[2]/text"
