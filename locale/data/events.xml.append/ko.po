#: src-en/data/events.xml.append:282
msgid ""
"data/events.xml.append$//event[@name=\"LILY_EMPORIUM_REAL\"]/choice[@req=\"LILY_MYSTERIOUS_NOTE\"]/text"
msgstr "발견했던 의문의 쪽지를 떠올립니다."

#: src-en/data/events.xml.append:284
msgid ""
"data/events.xml.append$//event[@name=\"LILY_EMPORIUM_REAL\"]/choice[@req=\"LILY_MYSTERIOUS_NOTE\"]/event/text"
msgstr "릴리에게 의문의 쪽지를 건네고 그녀의 반응을 기다립니다."

#: src-en/data/events.xml.append:286
